# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# .env holds secrets + config. auth.setup.ts reads these to log in once and
# save the session to playwright/.auth/state.json. Task tests then reuse the
# saved session and never see these credentials.

# The page your task scripts start from (used as baseURL). Trailing slash
# matters: relative goto('some/path') (no leading slash) resolves against
# this; a leading slash in goto() would drop any account-ID path segment.
BASE_URL=https://my.serviceautopilot.com/

# The login page (may be the same as BASE_URL or a dedicated /login).
LOGIN_URL=https://my.serviceautopilot.com/

# Credentials used ONLY by auth.setup.ts.
SAP_USER=you@example.com
SAP_PASS=change-me

# WhatConverts API credentials (https://www.whatconverts.com/api/).
# Auth is HTTP Basic as token:secret — WhatConverts dashboard > Integrations > API Keys.
WHATCONVERTS_API_TOKEN=
WHATCONVERTS_API_SECRET=

# Healthy Lawn NJ's WhatConverts profile_id (find via GET
# /api/v1/accounts/{account_id}/profiles or a lead's "profile_id" field).
WHATCONVERTS_PROFILE_ID=

# SMTP settings used to email the run log ("AUTOMATION LOGGING" subject).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
SMTP_FROM=you@example.com
SMTP_TO=omega@kudos.marketing

# Optional: override the WhatConverts pull range for a specific run.
# Format YYYY-MM-DD. Leave both blank to default to "today minus 4 days
# through yesterday".
# START_DATE=
# END_DATE=

# Add per-run inputs here as needed, e.g.:
# QUOTE_ID=12345
