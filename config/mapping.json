{
  "_comment": "What Converts source/medium -> ServiceAssistant 'Source' dropdown label. Matched case-insensitively against lead_source/lead_medium. Confirmed live 2026-07-05 against account 809961 (Healthy Lawn NJ). crmSource must exactly match an option in the live dropdown (verified list in _dropdown_options_confirmed_live).",
  "_dropdown_options_confirmed_live": [
    "AI - Chat GPT",
    "BNG - Bing Organic",
    "COM - Custom Commercial",
    "DDG - Duck Duck Go",
    "EC - Existing Customer",
    "GA - Google CPC",
    "GMB - GMB Organic",
    "INH - In-house",
    "LSA - LSA CPC",
    "ORG - Google Organic",
    "PC - Previous Cancellation",
    "PLD - Previous Lead",
    "POS - Saw Posting Sign",
    "RES - Custom Residential",
    "RF - Referral",
    "ST - Saw Truck",
    "WEB - Direct Visit",
    "Facebook Ads - CPC"
