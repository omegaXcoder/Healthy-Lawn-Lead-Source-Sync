  "rules": [
    { "source": "gmb", "medium": ["organic", "none", ""], "crmSource": "GMB - GMB Organic" },
    { "source": "google", "medium": ["organic"], "crmSource": "ORG - Google Organic" },
    { "source": "(direct)", "medium": ["(none)", "none", ""], "skip": true, "note": "Direct Visit — leave alone per client instructions" },
    { "source": "google", "medium": ["cpc"], "crmSource": "GA - Google CPC" },
    { "source": "lsa", "medium": ["cpc"], "crmSource": "LSA - LSA CPC" },
    { "source": "yahoo", "medium": ["organic"], "crmSource": "ORG - Google Organic" },
    { "source": "bing", "medium": ["cpc"], "crmSource": "BNG - Bing Organic", "note": "TEMPORARY: client's table says 'Bing'/CPC -> \"Bing\" but no plain Bing-CPC option exists in the live CRM dropdown. Client decided (2026-07-06) to map this to 'BNG - Bing Organic' for now until/unless a dedicated Bing CPC option is added." },
    { "source": "bing", "medium": ["organic"], "crmSource": "BNG - Bing Organic" },
    { "source": "duckduckgo", "medium": ["referral", "organic", "none", ""], "crmSource": "DDG - Duck Duck Go" },
    { "sourcePattern": "\\.com$", "medium": ["referral"], "crmSource": "ORG - Google Organic", "note": "catch-all: any referral source ending in .com" },
    { "source": "facebook", "medium": ["*"], "crmSource": "Facebook Ads - CPC" },
    { "source": "instagram", "medium": ["*"], "crmSource": "Facebook Ads - CPC" },
    { "source": "chatgpt", "medium": ["*"], "crmSource": "AI - Chat GPT" },
    { "source": "lawn sign", "medium": ["*"], "crmSource": "POS - Saw Posting Sign" }
  ]
