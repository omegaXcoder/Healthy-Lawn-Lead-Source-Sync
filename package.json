{
  "name": "playwright-sop-automations",
  "version": "1.0.0",
  "private": true,
  "description": "SOP-driven Playwright automations built via Playwright MCP",
  "scripts": {
    "auth": "playwright test --project=setup",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "sync:dry": "playwright test tests/sync.spec.ts",
    "sync:dry:headed": "playwright test tests/sync.spec.ts --headed",
    "sync:live": "cross-env LIVE_RUN=true playwright test tests/sync.spec.ts",
    "sync:live:headed": "cross-env LIVE_RUN=true playwright test tests/sync.spec.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.3"
  }
}
